datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id               String            @id @default(uuid())
  name             String
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organizations    Organization[]
  users            User[]
  entities         Entity[]
  agents           Agent[]
  workers          Worker[]
  connectors       Connector[]
  policies         Policy[]
  executions       Execution[]
  outputs          BusinessOutput[]
  economicValues   EconomicValue[]
  opportunities    Opportunity[]
  decisions        Decision[]
  actions          Action[]
  risks            Risk[]
  forecasts        Forecast[]
  auditEvents      AuditEvent[]
  knowledgeSources KnowledgeSource[]
  tasks            Task[]
}

model Organization {
  id               String            @id @default(uuid())
  tenantId         String
  name             String
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entities         Entity[]
  users            User[]
  agents           Agent[]
  workers          Worker[]
  executions       Execution[]
  outputs          BusinessOutput[]
  economicValues   EconomicValue[]
  opportunities    Opportunity[]
  decisions        Decision[]
  actions          Action[]
  risks            Risk[]
  forecasts        Forecast[]
  knowledgeSources KnowledgeSource[]
  tasks            Task[]

  @@index([tenantId])
}

model Entity {
  id             String         @id @default(uuid())
  tenantId       String
  organizationId String
  name           String
  country        String
  currency       String         @default("USD")
  status         String         @default("ACTIVE")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions     Execution[]
  outputs        BusinessOutput[]
  economicValues EconomicValue[]
  opportunities  Opportunity[]
  decisions      Decision[]
  actions        Action[]
  risks          Risk[]
  forecasts      Forecast[]

  @@index([tenantId])
  @@index([organizationId])
}

model User {
  id             String       @id @default(uuid())
  tenantId       String
  organizationId String?
  email          String       @unique
  name           String
  role           String       @default("ANALYST")
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  agentsOwned    Agent[]      @relation("AgentOwner")

  @@index([tenantId])
  @@index([organizationId])
}

model Agent {
  id             String         @id @default(uuid())
  tenantId       String
  organizationId String
  ownerId        String?
  name           String
  description    String
  objective      String
  rolePersona    String
  instructions   String         @default("")
  status         String         @default("ACTIVE") // ACTIVE, DRAFT, PAUSED, DISABLED
  autonomyLevel  String         @default("LEVEL_1_RECOMMEND")
  version        Int            @default(1)
  configuration  String         @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?          @relation("AgentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  agentSkills    AgentSkill[]
  agentTools     AgentTool[]
  agentConnectors AgentConnector[]
  agentKnowledge AgentKnowledgeSource[]
  versions       AgentVersion[]
  triggers       AgentTrigger[]
  tasks          Task[]
  executions     Execution[]
  outputs        BusinessOutput[]

  @@index([tenantId])
  @@index([organizationId])
}

model AgentVersion {
  id            String   @id @default(uuid())
  agentId       String
  version       Int
  configuration String   // Full snapshot JSON of agent configuration at version
  changelog     String   @default("Version updated")
  createdAt     DateTime @default(now())

  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
}

model Worker {
  id             String         @id @default(uuid())
  tenantId       String
  organizationId String
  name           String
  description    String
  purpose        String
  status         String         @default("ACTIVE")
  autonomyLevel  String         @default("LEVEL_1_RECOMMEND")
  configuration  String         @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workerSkills   WorkerSkill[]
  executions     Execution[]

  @@index([tenantId])
  @@index([organizationId])
}

model Skill {
  id                   String        @id @default(uuid())
  name                 String
  description          String
  category             String
  version              String        @default("1.0.0")
  status               String        @default("ACTIVE")
  inputs               String        @default("[]")
  outputs              String        @default("[]")
  dependencies         String        @default("[]")
  riskLevel            String        @default("LOW")
  autonomyLevel        String        @default("LEVEL_1_RECOMMEND")
  approvalRequirements String        @default("{}")
  metrics              String        @default("{}")
  configuration        String        @default("{}")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  workerSkills         WorkerSkill[]
  agentSkills          AgentSkill[]
  skillTools           SkillTool[]
}

model AgentSkill {
  id        String   @id @default(uuid())
  agentId   String
  skillId   String
  createdAt DateTime @default(now())

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
}

model WorkerSkill {
  id        String   @id @default(uuid())
  workerId  String
  skillId   String
  createdAt DateTime @default(now())

  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([workerId, skillId])
}

model Tool {
  id            String      @id @default(uuid())
  name          String
  description   String
  category      String
  inputSchema   String      @default("{}")
  outputSchema  String      @default("{}")
  riskLevel     String      @default("LOW")
  configuration String      @default("{}")
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  skillTools    SkillTool[]
  agentTools    AgentTool[]
}

model AgentTool {
  id        String   @id @default(uuid())
  agentId   String
  toolId    String
  createdAt DateTime @default(now())

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
}

model SkillTool {
  id        String   @id @default(uuid())
  skillId   String
  toolId    String
  createdAt DateTime @default(now())

  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([skillId, toolId])
}

model Connector {
  id                  String   @id @default(uuid())
  tenantId            String
  type                String   // GOOGLE_DRIVE, GOOGLE_SHEETS, GOOGLE_DOCS, GMAIL, GOOGLE_CALENDAR, ONEDRIVE, EXCEL_ONLINE, OUTLOOK, BANK_API, SAP_ERP, STRIPE, POSTGRES
  category            String   @default("FINANCE") // GOOGLE, MICROSOFT, FINANCE, BUSINESS, DATA
  name                String
  status              String   @default("NOT_CONFIGURED")
  configuration       String   @default("{}")
  credentialReference String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentConnectors     AgentConnector[]
  knowledgeSources    KnowledgeSource[]

  @@index([tenantId])
}

model AgentConnector {
  id          String    @id @default(uuid())
  agentId     String
  connectorId String
  createdAt   DateTime  @default(now())

  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([agentId, connectorId])
}

model KnowledgeSource {
  id             String   @id @default(uuid())
  tenantId       String
  organizationId String
  connectorId    String?
  name           String
  type           String   // GOOGLE_SHEET, GOOGLE_DRIVE_FOLDER, PDF_DOCUMENT, CSV_FILE, DATABASE_TABLE, URL_ENDPOINT
  uri            String   // Resource URI or URL
  status         String   @default("ACTIVE")
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector      Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  agentKnowledge AgentKnowledgeSource[]

  @@index([tenantId])
  @@index([organizationId])
}

model AgentKnowledgeSource {
  id                String          @id @default(uuid())
  agentId           String
  knowledgeSourceId String
  createdAt         DateTime        @default(now())

  agent             Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeSource   KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeSourceId])
}

model AgentTrigger {
  id            String   @id @default(uuid())
  agentId       String
  type          String   // MANUAL, SCHEDULE, EVENT, WEBHOOK, THRESHOLD, ANOMALY, DATA_CHANGE
  configuration String   @default("{}")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model Task {
  id             String      @id @default(uuid())
  tenantId       String
  organizationId String
  agentId        String
  title          String
  description    String
  status         String      @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED, CANCELLED
  priority       String      @default("MEDIUM")
  payload        String      @default("{}")
  result         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  executions     Execution[]

  @@index([tenantId])
  @@index([agentId])
}

model Policy {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String
  status      String   @default("ACTIVE")
  rules       String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Execution {
  id             String          @id @default(uuid())
  tenantId       String
  organizationId String
  entityId       String?
  workerId       String?
  agentId        String?
  taskId         String?
  trigger        String          @default("MANUAL")
  status         String          @default("PENDING")
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         Entity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  worker         Worker?         @relation(fields: [workerId], references: [id], onDelete: SetNull)
  agent          Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  steps          ExecutionStep[]
  outputs        BusinessOutput[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([workerId])
  @@index([agentId])
}

model ExecutionStep {
  id              String    @id @default(uuid())
  executionId     String
  type            String
  status          String    @default("PENDING")
  startedAt       DateTime?
  completedAt     DateTime?
  inputReference  String?
  outputReference String?
  error           String?
  metadata        String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  execution       Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model BusinessOutput {
  id             String           @id @default(uuid())
  tenantId       String
  organizationId String
  entityId       String?
  executionId    String?
  agentId        String?
  type           String           // INSIGHT, RECOMMENDATION, DECISION, REPORT, FORECAST, ALERT, OPPORTUNITY, ACTION_PROPOSAL, EXECUTED_ACTION, EXCEPTION
  status         String           @default("ACTIVE")
  confidence     Float            @default(0.0)
  source         String
  methodology    String
  summary        String           @default("")
  financialImpact Float           @default(0.0)
  data           String           @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         Entity?          @relation(fields: [entityId], references: [id], onDelete: SetNull)
  execution      Execution?       @relation(fields: [executionId], references: [id], onDelete: SetNull)
  agent          Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)

  economicValues EconomicValue[]
  opportunities  Opportunity[]
  decisions      Decision[]
  actions        Action[]
  risks          Risk[]
  forecasts      Forecast[]
  provenance     DataProvenance[]
  destinations   OutputDestination[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([executionId])
  @@index([agentId])
}

model OutputDestination {
  id               String         @id @default(uuid())
  businessOutputId String
  type             String         // DASHBOARD, EMAIL, GOOGLE_DOCS, GOOGLE_SHEETS, SLACK, TEAMS, PDF, WEBHOOK, APPROVAL_QUEUE
  target           String         // Target email address, channel ID, file ID, or webhook URL
  status           String         @default("PENDING") // PENDING, DELIVERED, FAILED
  deliveredAt      DateTime?
  metadata         String         @default("{}")
  createdAt        DateTime       @default(now())

  businessOutput   BusinessOutput @relation(fields: [businessOutputId], references: [id], onDelete: Cascade)

  @@index([businessOutputId])
}

model EconomicValue {
  id               String         @id @default(uuid())
  tenantId         String
  organizationId   String
  entityId         String?
  businessOutputId String?
  amount           Float
  currency         String         @default("USD")
  period           String         @default("ANNUAL")
  type             String
  confidence       Float          @default(1.0)
  source           String
  methodology      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity           Entity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  businessOutput   BusinessOutput? @relation(fields: [businessOutputId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([organizationId])
  @@index([businessOutputId])
}

model Opportunity {
  id               String         @id @default(uuid())
  tenantId         String
  organizationId   String
  entityId         String?
  businessOutputId String?
  title            String
  description      String
  category         String
  estimatedValue   Float
  currency         String         @default("USD")
  probability      Float          @default(0.5)
  expectedValue    Float
  urgency          String         @default("MEDIUM")
  effort           String         @default("MEDIUM")
  risk             String         @default("LOW")
  reversibility    String         @default("HIGH")
  confidence       Float          @default(0.8)
  status           String         @default("IDENTIFIED")
  recommendedAction String?
  owner            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity           Entity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  businessOutput   BusinessOutput? @relation(fields: [businessOutputId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([organizationId])
}

model Decision {
  id               String         @id @default(uuid())
  tenantId         String
  organizationId   String
  entityId         String?
  businessOutputId String?
  problem          String
  evidence         String         @default("[]")
  assumptions      String         @default("[]")
  alternatives     String         @default("[]")
  scenarios        String         @default("[]")
  economicImpact   Float          @default(0.0)
  risk             String         @default("LOW")
  policyStatus     String         @default("PASSED")
  recommendation   String
  approvalStatus   String         @default("PENDING")
  executionStatus  String         @default("NOT_STARTED")
  result           String?
  learning         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity           Entity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  businessOutput   BusinessOutput? @relation(fields: [businessOutputId], references: [id], onDelete: SetNull)

  actions          Action[]

  @@index([tenantId])
  @@index([organizationId])
}

model Action {
  id                 String         @id @default(uuid())
  tenantId           String
  organizationId     String
  entityId           String?
  businessOutputId   String?
  decisionId         String?
  type               String
  target             String
  amount             Float          @default(0.0)
  currency           String         @default("USD")
  status             String         @default("PROPOSED")
  approvalStatus     String         @default("PENDING")
  executionStatus    String         @default("NOT_STARTED")
  policyStatus       String         @default("COMPLIANT")
  verificationStatus String         @default("UNVERIFIED")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity             Entity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  businessOutput     BusinessOutput? @relation(fields: [businessOutputId], references: [id], onDelete: SetNull)
  decision           Decision?      @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([organizationId])
}

model Risk {
  id               String         @id @default(uuid())
  tenantId         String
  organizationId   String
  entityId         String?
  businessOutputId String?
  category         String
  exposure         Float
  currency         String         @default("USD")
  probability      Float          @default(0.1)
  impact           String         @default("MEDIUM")
  confidence       Float          @default(0.8)
  mitigation       String
  status           String         @default("ACTIVE")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity           Entity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  businessOutput   BusinessOutput? @relation(fields: [businessOutputId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([organizationId])
}

model Forecast {
  id               String         @id @default(uuid())
  tenantId         String
  organizationId   String
  entityId         String?
  businessOutputId String?
  horizon          String
  expected         Float
  lowerBound       Float
  upperBound       Float
  currency         String         @default("USD")
  confidence       Float          @default(0.85)
  methodology      String
  source           String
  dataType         String         @default("FORECAST")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity           Entity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  businessOutput   BusinessOutput? @relation(fields: [businessOutputId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([organizationId])
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  actor      String
  event      String
  resource   String
  resourceId String
  timestamp  DateTime @default(now())
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([event])
}

model DataProvenance {
  id               String         @id @default(uuid())
  businessOutputId String
  sourceType       String         // GOOGLE_SHEETS, GOOGLE_DRIVE, BANK_API, SAP_ERP, USER_INPUT, MODEL_ESTIMATE, SIMULATION
  sourceId         String         // URI, File ID, or Bank Account ID
  retrievedAt      DateTime       @default(now())
  method           String
  quality          Float          @default(1.0)
  coverage         Float          @default(1.0)
  metadata         String         @default("{}")
  createdAt        DateTime       @default(now())

  businessOutput   BusinessOutput @relation(fields: [businessOutputId], references: [id], onDelete: Cascade)

  @@index([businessOutputId])
}

model KnowledgeChunk {
  id                String          @id @default(uuid())
  tenantId          String
  knowledgeSourceId String
  chunkIndex        Int
  content           String
  contentHash       String
  embeddingJson     String          @default("[]") // Json array of float embeddings
  metadata          String          @default("{}") // Source, section, page numbers
  createdAt         DateTime        @default(now())

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeSource    KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([knowledgeSourceId])
  @@index([contentHash])
}
